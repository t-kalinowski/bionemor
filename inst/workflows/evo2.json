{
  "schema_version": 1,
  "adapter": "evo2-megatron",
  "adapter_version": 1,
  "family": "evo2",
  "protocol_version": 1,
  "workflows": [
    {
      "id": "evo2/checkpoint",
      "task": "checkpoint",
      "input_schema": "checkpoint/source-v1",
      "result_schema": "checkpoint/mbridge-v1"
    },
    {
      "id": "evo2/export",
      "task": "export",
      "input_schema": "path/destination-v1",
      "result_schema": "checkpoint/vortex-v1"
    },
    {
      "id": "evo2/prepare",
      "task": "prepare",
      "input_schema": "sequence/dna-v1",
      "result_schema": "dataset/evo2-indexed-v1"
    },
    {
      "id": "evo2/fine-tune",
      "task": "fine-tune",
      "input_schema": "dataset/evo2-indexed-v1",
      "result_schema": "model/evo2-v1"
    },
    {
      "id": "evo2/generate",
      "task": "generate",
      "input_schema": "sequence/dna-v1",
      "result_schema": "table/evo2-generation-v1"
    },
    {
      "id": "evo2/score",
      "task": "score",
      "input_schema": "sequence/dna-v1",
      "result_schema": "table/evo2-scores-v1"
    },
    {
      "id": "evo2/profile",
      "task": "profile",
      "input_schema": "sequence/dna-v1",
      "result_schema": "artifact/evo2-profile-v1"
    },
    {
      "id": "evo2/embed",
      "task": "embed",
      "input_schema": "sequence/dna-v1",
      "result_schema": "result/evo2-embeddings-v1"
    }
  ]
}
